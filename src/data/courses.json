{
    "js101": {
        "name": "Intro to JavaScript",
        "desc": "Master the core building blocks of JavaScript with hands-on lessons. This course lays a strong foundation for writing logic, organizing data, and creating structured, interactive code—perfect for aspiring developers taking their first steps into programming.",
        "lang": "javascript",
        "sections": [
            {
                "title": "Basic Concepts",
                "desc": "This unit goes over basic concepts of JavaScript, including variables, constants, number operations, string concatenation, and logging to the console.",
                "lessons": [
                    {
                        "title": "Log to The Console",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Log the value 1",
                                "check": "logs.includes(1)"
                            },
                            {
                                "text": "Log the value 3.14",
                                "check": "logs.includes(3.14)"
                            },
                            {
                                "text": "Log the value true or false",
                                "check": "(logs.includes(true) || logs.includes(false))"
                            },
                            {
                                "text": "Log the value null",
                                "check": "logs.includes(null)"
                            },
                            {
                                "text": "Log the value \"Hello World\"",
                                "check": "logs.includes(\"Hello World\")"
                            }
                        ]
                    },
                    {
                        "title": "Variables",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named city with any value",
                                "check": "typeof city !== undefined"
                            },
                            {
                                "text": "Change the value of city to \"Chicago\"",
                                "check": "city === 'Chicago'"
                            },
                            {
                                "text": "Log the variable city to the console",
                                "check": "logs.includes('Chicago')"
                            }
                        ]
                    },
                    {
                        "title": "Constants",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a constant named myName with the value of your name",
                                "check": "typeof myName !== undefined"
                            },
                            {
                                "text": "Log myName to the console!",
                                "check": "logs.includes(myName)"
                            }
                        ]
                    },
                    {
                        "title": "Number Operations",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create 4 variables named, add, sub, mul, and div all, set them all to the value of 4",
                                "check": "typeof add === 'number' && typeof sub === 'number' && typeof mul === 'number' && typeof div === 'number'"
                            },
                            {
                                "text": "Add 87 to the add variable",
                                "check": "add === 4 + 87"
                            },
                            {
                                "text": "Subtract 938 to the sub variable",
                                "check": "sub === 4 - 938"
                            },
                            {
                                "text": "Multiply the mul variable by 3.14",
                                "check": "mul === 4 * 3.14"
                            },
                            {
                                "text": "Divide the div variable by 8",
                                "check": "div === 4 / 8"
                            }
                        ]
                    },
                    {
                        "title": "String Concatenation",
                        "type": "FRQ"
                    }
                ]
            },
            {
                "title": "If/Else Statements and Logic",
                "desc": "This unit covers if/else statements and general logic, javascripts unique equality properties, and truthy and falsy statements.",
                "lessons": [
                    {
                        "title": "Comparison Operators",
                        "type": "FRQ"
                    },
                    {
                        "title": "If Statements",
                        "type": "FRQ"
                    },
                    {
                        "title": "If/Else",
                        "type": "FRQ"
                    },
                    {
                        "title": "Else If",
                        "type": "FRQ"
                    },
                    {
                        "title": "Logical Operators",
                        "type": "FRQ"
                    },
                    {
                        "title": "Truthy and Falsy",
                        "type": "FRQ"
                    }
                ]
            },
            {
                "title": "Functions",
                "desc": "This unit covers everything to do with functions, parameters, return values, intro level scope, and arrow functions.",
                "lessons": [
                    {
                        "title": "No-Parameter Functions",
                        "type": "FRQ"
                    },
                    {
                        "title": "Functions with Parameters",
                        "type": "FRQ"
                    },
                    {
                        "title": "Return Values",
                        "type": "FRQ"
                    },
                    {
