{
    "js101": {
        "name": "Intro to JavaScript",
        "desc": "Master the core building blocks of JavaScript with hands-on lessons. This course lays a strong foundation for writing logic, organizing data, and creating structured, interactive code—perfect for aspiring developers taking their first steps into programming.",
        "lang": "javascript",
        "sections": [
            {
                "title": "Basic Concepts",
                "desc": "This unit goes over basic concepts of JavaScript, including variables, constants, number operations, string concatenation, and logging to the console.",
                "lessons": [
                    {
                        "title": "Log to The Console",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Log the value 1",
                                "check": "logs.includes(1)"
                            },
                            {
                                "text": "Log the value 3.14",
                                "check": "logs.includes(3.14)"
                            },
                            {
                                "text": "Log the value true or false",
                                "check": "(logs.includes(true) || logs.includes(false))"
                            },
                            {
                                "text": "Log the value null",
                                "check": "logs.includes(null)"
                            },
                            {
                                "text": "Log the value \"Hello World\"",
                                "check": "logs.includes(\"Hello World\")"
                            }
                        ]
                    },
                    {
                        "title": "Variables",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named city with any value",
                                "check": "typeof city !== undefined"
                            },
                            {
                                "text": "Change the value of city to \"Chicago\"",
                                "check": "city === 'Chicago'"
                            },
                            {
                                "text": "Log the variable city to the console",
                                "check": "logs.includes('Chicago')"
                            }
                        ]
                    },
                    {
                        "title": "Constants",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a constant named myName with the value of your name",
                                "check": "typeof myName !== undefined"
                            },
                            {
                                "text": "Log myName to the console!",
                                "check": "logs.includes(myName)"
                            }
                        ]
                    },
                    {
                        "title": "Number Operations",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create 4 variables named, add, sub, mul, and div all, set them all to the value of 4",
                                "check": "typeof add === 'number' && typeof sub === 'number' && typeof mul === 'number' && typeof div === 'number'"
                            },
                            {
                                "text": "Add 87 to the add variable",
                                "check": "add === 4 + 87"
                            },
                            {
                                "text": "Subtract 938 to the sub variable",
                                "check": "sub === 4 - 938"
                            },
                            {
                                "text": "Multiply the mul variable by 3.14",
                                "check": "mul === 4 * 3.14"
                            },
                            {
                                "text": "Divide the div variable by 8",
                                "check": "div === 4 / 8"
                            }
                        ]
                    },
                    {
                        "title": "String Concatenation",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named city with any string value",
                                "check": "typeof city === 'string'"
                            },
                            {
                                "text": "Log \"Hello from CITY\" to the console",
                                "check": "logs[0].includes(`Hello from`)"
                            },
                            {
                                "text": "Change the variable of city to a different string value",
                                "check": "typeof city === 'string'"
                            },
                            {
                                "text": "Log \"Hello from CITY\" to the console a second time",
                                "check": "logs[1].includes(`Hello from`)"
                            }
                        ]
                    },
                    {
                        "title": "Your City",
                        "type": "Unit Test",
                        "tasks": [
                            {
                                "text": "Create a constant named cityName with the value of your city's name as a string.",
                                "check": "typeof cityName === 'string'"
                            },
                            {
                                "text": "Create a variable named cityPop with the value of your city's population",
                                "check": "typeof cityPop === 'number'"
                            },
                            {
                                "text": "Log \"cityName - Population: cityPop\" to the console",
                                "check": "logs.includes(`${cityName} - Population: ${cityPop}`)"
                            },
                            {
                                "text": "Change your city's population to 1 million",
                                "check": "cityPop === 1000000"
                            },
                            {
                                "text": "Log \"cityName - Population: cityPop\" to the console",
                                "check": "logs.includes(`${cityName} - Population: 1000000`)"
                            }
                        ]
                    }
                ]
            },
            {
                "title": "If/Else Statements and Logic",
                "desc": "This unit covers if/else statements and general logic, javascript's unique equality properties, and truthy and falsy statements.",
                "lessons": [
                    {
                        "title": "Comparison Operators",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Log the result of 5 > 3",
                                "check": "logs[0] === true"
                            },
                            {
                                "text": "Log the result of 10 < 2",
                                "check": "logs[1] === false"
                            },
                            {
                                "text": "Log the result of 7 >= 7",
                                "check": "logs[2] === true"
                            },
                            {
                                "text": "Log the result of 4 <= 3",
                                "check": "logs[3] === false"
                            },
                            {
                                "text": "Log the result of 8 == '8'",
                                "check": "logs[4] === true"
                            },
                            {
                                "text": "Log the result of 8 === '8'",
                                "check": "logs[5] === false"
                            },
                            {
                                "text": "Log the result of 9 != 5",
                                "check": "logs[6] === true"
                            },
                            {
                                "text": "Log the result of 9 !== '9'",
                                "check": "logs[7] === true"
                            }
                        ]
                    },
                    {
                        "title": "If Statements",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named age set to 20, then log 'Adult' if age is greater than or equal to 18",
                                "check": "(age === 20 && logs.includes('Adult'))"
                            },
                            {
                                "text": "Create a variable named temperature set to 15, then log 'Cold' if temperature is less than 25",
                                "check": "(temperature === 15 && logs.includes('Cold'))"
                            },
                            {
                                "text": "Create a variable named score set to 55, then log 'Failed' if score is less than 60",
                                "check": "(score === 55 && logs.includes('Failed'))"
                            },
                            {
                                "text": "Create a variable named isLoggedIn set to true, then log 'Welcome!' if isLoggedIn is true",
                                "check": "(isLoggedIn === true && logs.includes('Welcome!'))"
                            },
                            {
                                "text": "Create a variable named hasAccess set to false, then log 'Access Denied' if hasAccess is false",
                                "check": "(hasAccess === false && logs.includes('Access Denied'))"
                            }
                        ]
                    },
                    {
                        "title": "If/Else",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named score set to 80. If score is 100, log 'Perfect'; else log 'Keep Trying'",
                                "check": "(score === 80 && logs.includes('Keep Trying') && !logs.includes('Perfect'))"
                            },
                            {
                                "text": "Create a variable named isMember set to false. If isMember is true, log 'Discount Applied'; else log 'No Discount'",
                                "check": "(isMember === false && logs.includes('No Discount') && !logs.includes('Discount Applied'))"
                            },
                            {
                                "text": "Create a variable named temperature set to 30. If temperature is less than 25, log 'Cold'; else log 'Warm'",
                                "check": "(temperature === 30 && logs.includes('Warm') && !logs.includes('Cold'))"
                            }
                        ]
                    },
                    {
                        "title": "Else If",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named grade set to 85. If grade is 90 or above, log 'A'; else if grade is 80 or above, log 'B'; else log 'C'",
                                "check": "(grade === 85 && logs.includes('B') && !logs.includes('A') && !logs.includes('C'))"
                            },
                            {
                                "text": "Create a variable named temperature set to 10. If temperature is above 30, log 'Hot'; else if temperature is above 20, log 'Warm'; else log 'Cold'",
                                "check": "(temperature === 10 && logs.includes('Cold') && !logs.includes('Hot') && !logs.includes('Warm'))"
                            },
                            {
                                "text": "Create a variable named score set to 95. If score is less than 60, log 'Fail'; else if score is less than 90, log 'Good'; else log 'Excellent'",
                                "check": "(score === 95 && logs.includes('Excellent') && !logs.includes('Good') && !logs.includes('Fail'))"
                            }
                        ]
                    },
                    {
                        "title": "Logical Operators",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create two variables: isSunny set to true and isWeekend set to true. Log 'Go Outside' if both are true",
                                "check": "(isSunny === true && isWeekend === true && logs.includes('Go Outside'))"
                            },
                            {
                                "text": "Create two variables: hasTicket set to true and isVIP set to false. Log 'Entry Allowed' if either is true",
                                "check": "(hasTicket === true && isVIP === false && logs.includes('Entry Allowed'))"
                            },
                            {
                                "text": "Create a variable named isRaining set to false. Log 'No Umbrella Needed' if it is not raining",
                                "check": "(isRaining === false && logs.includes('No Umbrella Needed'))"
                            },
                            {
                                "text": "Create two variables: isLoggedIn set to true and hasPermission set to false. Log 'Access Granted' only if both are true",
                                "check": "(isLoggedIn === true && hasPermission === false && !logs.includes('Access Granted'))"
                            },
                            {
                                "text": "Create two variables: age set to 16 and hasConsent set to true. Log 'Allowed' if age is at least 18 or hasConsent is true",
                                "check": "(age === 16 && hasConsent === true && logs.includes('Allowed'))"
                            },
                            {
                                "text": "Create a variable named isOnline set to true. Log 'Offline Mode' only if isOnline is false",
                                "check": "(isOnline === true && !logs.includes('Offline Mode'))"
                            }
                        ]
                    },
                    {
                        "title": "Truthy and Falsy",
                        "type": "FRQ",
                        "tasks": [
                            {
                                "text": "Create a variable named name set to an empty string ''. If name is truthy, log 'Has Name'; else log 'No Name'",
                                "check": "(name === '' && logs.includes('No Name') && !logs.includes('Has Name'))"
                            },
                            {
                                "text": "Create a variable named count set to 0. If count is falsy, log 'Empty'; else log 'Has Count'",
                                "check": "(count === 0 && logs.includes('Empty') && !logs.includes('Has Count'))"
                            },
                            {
                                "text": "Create a variable named isActive set to 'hello'. If isActive is truthy, log 'Active'; else log 'Inactive'",
                                "check": "(isActive === 'hello' && logs.includes('Active') && !logs.includes('Inactive'))"
                            }
                        ]
                    }
                ]
            },
            {
                "title": "Math",
                "desc": "This unit covers the Math class in JavaScript, including its constants, rounding methods, random number generation, and common mathematical functions.",
                "lessons": [
                    {
                        "title": "Math Constants",
                        "type": "FRQ"
                    },
                    {
                        "title": "Rounding Methods",
                        "type": "FRQ"
                    },
                    {
                        "title": "Min and Max",
                        "type": "FRQ"
                    },
                    {
                        "title": "Powers and Roots",
                        "type": "FRQ"
                    },
                    {
                        "title": "Random Numbers",
                        "type": "FRQ"
                    },
                    {
                        "title": "Trigonometry",
                        "type": "FRQ"
                    },
                    {
                        "title": "Advanced Math",
                        "type": "FRQ"
                    }
                ]
            },
            {
                "title": "String Methods",
                "desc": "This unit covers methods used with string, difference in string types, escape characters, and template literals.",
                "lessons": [
                    {
                        "title": "String Basics and Types",
                        "type": "FRQ"
                    },
                    {
                        "title": "String Length and Access",
                        "type": "FRQ"
                    },
                    {
                        "title": "String Case Methods",
                        "type": "FRQ"
                    },
                    {
                        "title": "Searching and Indexing",
                        "type": "FRQ"
                    },
                    {
                        "title": "Extracting Substrings",
                        "type": "FRQ"
                    },
                    {
                        "title": "Replacing and Trimming",
                        "type": "FRQ"
                    },
                    {
                        "title": "Template Literals and Escape Characters",
                        "type": "FRQ"
                    },
                    {
                        "title": "Advanced String Methods",
                        "type": "FRQ"
                    }
                ]
            },
            {
                "title": "Functions",
                "desc": "This unit covers everything to do with functions, parameters, return values, intro level scope, and arrow functions.",
                "lessons": [
                    {
                        "title": "No-Parameter Functions",
                        "type": "FRQ"
                    },
                    {
                        "title": "Functions with Parameters",
                        "type": "FRQ"
                    },
                    {
                        "title": "Return Values",
                        "type": "FRQ"
                    },
                    {
                        "title": "Multiple Parameters",
                        "type": "FRQ"
                    },
                    {
                        "title": "Scope (Intro Level)",
                        "type": "FRQ"
                    },
                    {
                        "title": "Function Expressions & Arrow Functions",
                        "type": "FRQ"
                    }
                ]
            }
        ]
    },
    "js201": {
        "name": "Intermediate JavaScript",
        "desc": "This course will take your coding skills to the next level with a deeper look into how JavaScript really works. You'll explore advanced functions, objects, and asynchronous programming to write cleaner, more powerful code. By the end, you'll be ready to handle complex logic and build more dynamic, real-world applications.",
        "lang": "javascript",
        "sections": [
            {
                "title": "Arrays",
                "desc": "This unit covers everything to with arrays, getting, setting, and deleting values and methods.",
                "lessons": []
            },
            {
                "title": "Loops",
                "desc": "This unit covers everything to with loops, both while and for, and their subtypes.",
                "lessons": []
            },
            {
                "title": "Objects",
                "desc": "This unit covers everything to with objects, how to loop through them, get items, set items, along with some useful methods.",
                "lessons": []
            }
        ]
    }
}